{
  "name": "@debdipbhat/acr",
  "version": "0.1.1-beta.0",
  "description": "Production-quality, terminal-first JavaScript and React code reviewer powered by static analysis and AI.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "acr": "bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "author": "Debdip Bhattacharya",
  "license": "MIT",
  "keywords": [
    "acr",
    "code-review",
    "javascript",
    "react",
    "cli",
    "static-analysis",
    "ai",
    "developer-tools"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node bin/cli.js --help",
    "test:package": "node scripts/test-package.js",
    "release:check": "node scripts/release-check.js",
    "audit:prod": "npm audit --omit=dev",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run release:check && npm test && npm run check"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.12.0",
    "ignore": "^7.0.8",
    "openai": "^7.10.0",
    "ora": "^8.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "vitest": "^3.0.7"
  }
}
