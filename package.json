{
  "name": "ai-code-reviewer",
  "version": "0.1.0",
  "description": "Terminal-first AI-assisted code reviewer for JavaScript and React projects.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "ai-code-reviewer": "./bin/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "author": "Debdip Bhattacharya",
  "license": "MIT",
  "keywords": [
    "code-review",
    "javascript",
    "react",
    "cli",
    "static-analysis",
    "developer-tools"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node bin/cli.js --help",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm test && npm run check"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "eslint": "^10.9.1",
    "fast-glob": "^3.3.3",
    "globals": "^17.12.0",
    "ignore": "^7.0.8",
    "ora": "^8.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "vitest": "^3.0.7"
  }
}
